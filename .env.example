# Copy to .env for local runs. On Vercel, set these in Project → Settings → Environment Variables.

# Postgres connection (Vercel → Storage → Neon creates DATABASE_URL / POSTGRES_URL automatically)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random string, 32+ characters, used to sign login cookies. Generate one: openssl rand -base64 48
SESSION_SECRET=

# One-time key for /setup.html (import data / create first admin). 12+ characters.
SETUP_KEY=

# Optional — send alert emails through Resend (https://resend.com). Leave empty to only queue them.
RESEND_API_KEY=
MAIL_FROM=OfficeHub <alerts@your-domain.com>
